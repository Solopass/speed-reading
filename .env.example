# Nothing here is required. By default the AI features use a local model through
# Ollama (http://127.0.0.1:11434, set in Settings -> AI Features), and without
# one they fall back to a copy/paste panel that works with any assistant.

# Only needed if you pick "Gemini API" in Settings.
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional model override.
# VITE_GEMINI_MODEL=gemini-3-flash-preview
